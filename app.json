{
  "expo": {
    "name": "KJubilee",
    "slug": "kjubilee",
    "scheme": "kjubilee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/KJubilee-App-Icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/KJubilee-App-Icon.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "com.kjubilee.app",
      "associatedDomains": [
        "applinks:kjubilee.com",
        "applinks:www.kjubilee.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.kjubilee.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/KJubilee-adaptive-foreground.png"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kjubilee.com",
              "pathPrefix": "/album"
            },
            {
              "scheme": "https",
              "host": "kjubilee.com",
              "pathPrefix": "/artist"
            },
            {
              "scheme": "https",
              "host": "kjubilee.com",
              "pathPrefix": "/hm"
            },
            {
              "scheme": "https",
              "host": "kjubilee.com",
              "pathPrefix": "/dial"
            },
            {
              "scheme": "https",
              "host": "kjubilee.com",
              "pathPrefix": "/player"
            },
            {
              "scheme": "https",
              "host": "kjubilee.com",
              "pathPrefix": "/browse"
            },
            {
              "scheme": "https",
              "host": "kjubilee.com",
              "pathPrefix": "/map"
            },
            {
              "scheme": "https",
              "host": "kjubilee.com",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "kjubilee.com",
              "pathPrefix": "/home"
            },
            {
              "scheme": "https",
              "host": "www.kjubilee.com",
              "pathPrefix": "/album"
            },
            {
              "scheme": "https",
              "host": "www.kjubilee.com",
              "pathPrefix": "/artist"
            },
            {
              "scheme": "https",
              "host": "www.kjubilee.com",
              "pathPrefix": "/hm"
            },
            {
              "scheme": "https",
              "host": "www.kjubilee.com",
              "pathPrefix": "/dial"
            },
            {
              "scheme": "https",
              "host": "www.kjubilee.com",
              "pathPrefix": "/player"
            },
            {
              "scheme": "https",
              "host": "www.kjubilee.com",
              "pathPrefix": "/browse"
            },
            {
              "scheme": "https",
              "host": "www.kjubilee.com",
              "pathPrefix": "/map"
            },
            {
              "scheme": "https",
              "host": "www.kjubilee.com",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "www.kjubilee.com",
              "pathPrefix": "/home"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-localization",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      "./plugins/withSafeUserLeaveHint"
    ],
    "extra": {
      "cdnBaseUrl": "https://cdn.kjubilee.com",
      "apiBaseUrl": "https://api.kjubilee.com/v1",
      "useMock": false,
      "dataSource": "manifest",
      "authBaseUrl": "https://kjubilee.com",
      "mobileConfigBaseUrl": "https://kjubilee.com",
      "turnstileSiteKey": "0x4AAAAAAEP1RePvfYIIioIf",
      "turnstileBaseUrl": "https://kjubilee.com",
      "eas": {
        "projectId": "79bcd2c9-7c59-43e7-926a-b32332410a6f"
      }
    },
    "owner": "gabeungureanu"
  }
}
